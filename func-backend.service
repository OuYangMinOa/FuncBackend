[Unit]
Description=Func Backend API
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/func_backend
ExecStart=/home/ubuntu/func_backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 7666
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
MemoryMax=150M

[Install]
WantedBy=multi-user.target
